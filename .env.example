# Postgres + PostGIS (not required for the demo build; the web app falls back to seeded demo data)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nireekshanam
# Session signing secret for the web app
SESSION_SECRET=change-me
# MSG91 OTP (https://control.msg91.com). Leave both empty for demo mode (no SMS; code 246810).
# Authkey: turn off "IP security" for it, or whitelist your server IPs (Vercel functions have no fixed IPs).
MSG91_AUTH_KEY=
# OTP template ID: its text must match the DLT-approved template, with ##OTP## for the code.
MSG91_OTP_TEMPLATE_ID=
